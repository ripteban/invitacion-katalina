---
// Música de fondo: empieza al tocar el sobre (los navegadores no permiten sonido sin un toque previo)
// y se puede silenciar con el botón flotante. El fundido de entrada/salida viene en el propio archivo
// (en iPhone el volumen no se puede controlar desde la página).
---

<audio id="musica" src="/medios/musica.m4a" loop preload="none"></audio>

<button class="musica" id="boton-musica" type="button" aria-label="Silenciar música" aria-pressed="true" hidden>
  <span class="musica__barras" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
  <svg class="musica__silencio" viewBox="0 0 24 24" aria-hidden="true">
    <path d="M4 9.5v5h3.2L12 18.6V5.4L7.2 9.5H4z" fill="currentColor" />
    <path d="M16 9l5 6M21 9l-5 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" fill="none" />
  </svg>
</button>

<style>
  .musica {
    --lado: 46px;
    position: fixed;
    z-index: 30;
    right: max(16px, calc((100vw - var(--ancho)) / 2 + 16px));
    bottom: calc(16px + env(safe-area-inset-bottom));
    width: var(--lado);
    height: var(--lado);
    display: grid;
    place-items: center;
    border-radius: 50%;
    color: var(--rosa);
    background: rgba(255, 250, 247, 0.86);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    box-shadow:
      0 8px 22px -8px rgba(92, 64, 66, 0.45),
      inset 0 0 0 1px rgba(232, 124, 142, 0.25);
    cursor: pointer;
    opacity: 0;
    scale: 0.6;
    transition:
      opacity 400ms var(--ease-out),
      scale 500ms var(--ease-gentle);
    -webkit-tap-highlight-color: transparent;
  }
  .musica.visible {
    opacity: 1;
    scale: 1;
  }
  .musica:active {
    scale: 0.92;
  }
  .musica:focus-visible {
    outline: 2px solid var(--rosa);
    outline-offset: 3px;
  }
  /* Ecualizador animado mientras suena */
  .musica__barras {
    display: flex;
    align-items: flex-end;
    gap: 3px;
    height: 16px;
  }
  .musica__barras i {
    width: 3px;
    height: 100%;
    border-radius: 2px;
    background: currentColor;
    transform-origin: bottom;
    animation: barra 900ms ease-in-out infinite;
  }
  .musica__barras i:nth-child(2) { animation-delay: -300ms; animation-duration: 750ms; }
  .musica__barras i:nth-child(3) { animation-delay: -550ms; animation-duration: 1000ms; }
  .musica__barras i:nth-child(4) { animation-delay: -150ms; animation-duration: 820ms; }
  @keyframes barra {
    0%, 100% { scale: 1 0.3; }
    50% { scale: 1 1; }
  }
  .musica__silencio {
    display: none;
    width: 22px;
    height: 22px;
  }
  .musica[aria-pressed='false'] .musica__barras { display: none; }
  .musica[aria-pressed='false'] .musica__silencio { display: block; }
  @media (prefers-reduced-motion: reduce) {
    .musica__barras i { animation: none; scale: 1 0.6; }
  }
</style>
