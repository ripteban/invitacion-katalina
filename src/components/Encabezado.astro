---
// Tiara + "Katalina" + "Mis 15 Años" (caja 378×239 de Figma). Usado en la intro y en el Home.
import Img from './Img.astro';
import tiara from '../assets/comun/tiara.png';
import katalina from '../assets/svg/katalina.svg?url';
import mis15 from '../assets/svg/mis-15-anos.svg?url';

interface Props {
  class?: string;
  style?: string;
  /** h1 en el Home, div en la intro */
  titulo?: boolean;
}
const { class: clase = '', style, titulo = false } = Astro.props;
const Tag = titulo ? 'h1' : 'div';
---

<Tag class:list={['encabezado', clase]} style={style}>
  <span class="solo-lectores">Katalina · Mis 15 Años</span>
  <img class="encabezado__katalina" src={katalina} alt="" width="340" height="109" />
  <img class="encabezado__mis15" src={mis15} alt="" width="239" height="47" />
  <Img src={tiara} ancho={189.56} class="encabezado__tiara anim-flotar" style="--giro:-2deg;--dur:5s" escala={titulo ? 'home' : 'intro'} eager />
</Tag>

<style>
  .encabezado {
    position: relative;
    width: calc(378 * var(--k));
    height: calc(239 * var(--k));
    margin: 0;
    font: inherit;
  }
  .encabezado > :global(*) {
    position: absolute;
  }
  .encabezado__katalina {
    left: calc((21.5 + 2.451) * var(--k));
    top: calc(61.187 * var(--k));
    width: calc(339.537 * var(--k));
    height: calc(108.682 * var(--k));
  }
  .encabezado__mis15 {
    left: calc((21.5 + 69.738) * var(--k));
    top: calc(176.794 * var(--k));
    width: calc(238.995 * var(--k));
    height: calc(47.294 * var(--k));
  }
  .encabezado :global(.encabezado__tiara) {
    left: calc((21.5 + 0.121) * var(--k));
    top: calc(-12 * var(--k));
    width: calc(189.56 * var(--k));
    height: calc(112.995 * var(--k));
  }
  .encabezado :global(.encabezado__tiara img) {
    width: 100%;
    height: 100%;
  }
</style>
